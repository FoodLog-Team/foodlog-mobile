# Copy this file to .env.local (git-ignored) and set your own values.
# Restart the dev server after changing it.
# EXPO_PUBLIC_* values are inlined into the app bundle. Never put secrets here.

# Base URL of the FoodLog backend REST API, including the /api context path.
# A phone can't reach "localhost" on your computer, so use the computer's LAN IP address
# (the same address Expo prints after "Metro: exp://"), e.g. http://192.168.1.20:8080/api
EXPO_PUBLIC_API_URL=
